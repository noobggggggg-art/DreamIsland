<Window x:Class="DreamIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DreamIsland"
        Width="640" Height="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ClipRow" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C2C2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Свечение живёт на отдельном слое: эффект не перерисовывается из-за анимаций внутри острова -->
        <Border x:Name="GlowBack" Background="Black"
                Width="{Binding ActualWidth, ElementName=Island}"
                Height="{Binding ActualHeight, ElementName=Island}"
                CornerRadius="{Binding CornerRadius, ElementName=Island}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="False"/>

        <Border x:Name="Island"
                Background="Black" ClipToBounds="True"
                Width="130" Height="32" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Cursor="Hand"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_Click"
                MouseWheel="Island_Wheel"
                ContextMenuOpening="Island_ContextMenuOpening">

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Tag="micwatch" Header="Следить за микрофоном (по звуку)"
                              IsCheckable="True" Click="MicWatch_Click"/>
                    <MenuItem Tag="micdebug" Header="Показать уровень микрофона (отладка)"
                              IsCheckable="True" Click="MicDebug_Click"/>
                    <Separator/>
                    <MenuItem Header="Таймер">
                        <MenuItem Header="5 минут" Tag="5" Click="Timer_Click"/>
                        <MenuItem Header="10 минут" Tag="10" Click="Timer_Click"/>
                        <MenuItem Header="15 минут" Tag="15" Click="Timer_Click"/>
                        <MenuItem Header="25 минут" Tag="25" Click="Timer_Click"/>
                        <MenuItem Header="45 минут" Tag="45" Click="Timer_Click"/>
                        <MenuItem Header="1 час" Tag="60" Click="Timer_Click"/>
                    </MenuItem>
                    <MenuItem Tag="stopwatch" Header="Секундомер" Click="Stopwatch_Click"/>
                    <MenuItem Tag="pomodoro" Header="Помодоро (25 / 5)" Click="Pomodoro_Click"/>
                    <MenuItem Tag="timerpause" Header="Пауза / продолжить таймер" Click="TimerPause_Click"/>
                    <MenuItem Tag="timerstop" Header="Остановить таймер" Click="TimerStop_Click"/>
                    <Separator/>
                    <Separator/>
                    <MenuItem Tag="liveeq" Header="Живой эквалайзер (под звук)"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="clip" Header="История буфера обмена"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="clipclear" Header="Очистить историю буфера" Click="ClipClear_Click"/>
                    <MenuItem Tag="shots" Header="Плашка скриншотов"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="priv" Header="Точка записи (микрофон / камера)"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="ts3" Header="Следить за TeamSpeak 3"
                              IsCheckable="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="ts3key" Header="TeamSpeak 3: API-ключ…" Click="Ts3Key_Click"/>
                    <MenuItem Tag="ts3name" Header="TeamSpeak 3: название сервера…" Click="Ts3Name_Click"/>
                    <MenuItem Tag="ts3check" Header="TeamSpeak 3: проверить подключение" Click="Ts3Check_Click"/>
                    <MenuItem Tag="dl" Header="Показывать загрузки Steam / Epic"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="dlnow" Header="Загрузки: показать сейчас" Click="DownloadNow_Click"/>
                    <MenuItem Tag="vidapp" Header="Этот плеер показывает видео"
                              IsCheckable="True" IsEnabled="False" Click="VideoApp_Click"/>
                    <MenuItem Tag="emo" Header="Эмоции для видео"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="screen" Header="Эмоции: цвет и вспышки по картинке видео"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="spk" Header="Эмоции: колонки в чёрных полосах по бокам"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Header="Эмоции: стиль колонок">
                        <MenuItem Tag="spkstyle0" Header="Неон" IsCheckable="True" IsChecked="True" Click="SpkStyle_Click"/>
                        <MenuItem Tag="spkstyle1" Header="Ретро" IsCheckable="True" Click="SpkStyle_Click"/>
                        <MenuItem Tag="spkstyle2" Header="Минимализм" IsCheckable="True" Click="SpkStyle_Click"/>
                    </MenuItem>
                    <MenuItem Tag="spkfloat" Header="Эмоции: колонки поверх картинки, если нет чёрных полос"
                              IsCheckable="True" Click="FeatureToggle_Click"/>
                    <MenuItem Header="Эмоции: чувствительность (дроп, искры, нарастание)">
                        <MenuItem Tag="sens0" Header="Тихо (только самые сильные моменты)" IsCheckable="True" Click="Sens_Click"/>
                        <MenuItem Tag="sens1" Header="Обычно" IsCheckable="True" IsChecked="True" Click="Sens_Click"/>
                        <MenuItem Tag="sens2" Header="Жёстко (реагирует на всё)" IsCheckable="True" Click="Sens_Click"/>
                    </MenuItem>
                    <MenuItem Tag="emodebug" Header="Эмоции: отладочная панель с числами"
                              IsCheckable="True" Click="FeatureToggle_Click"/>
                    <MenuItem Header="Эмоции: анимация">
                        <MenuItem Tag="emo0" Header="Авто" IsCheckable="True" IsChecked="True" Click="EmoMode_Click"/>
                        <MenuItem Tag="emo1" Header="Спектр" IsCheckable="True" Click="EmoMode_Click"/>
                        <MenuItem Tag="emo2" Header="Пульс" IsCheckable="True" Click="EmoMode_Click"/>
                        <MenuItem Tag="emo3" Header="Вспышка" IsCheckable="True" Click="EmoMode_Click"/>
                    </MenuItem>
                    <MenuItem Tag="lowgpu" Header="Экономия видеопамяти (после перезапуска)"
                              IsCheckable="True" Click="FeatureToggle_Click"/>
                    <Separator/>
                    <MenuItem Tag="files" Header="Плашка файлов в проводнике"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="scvol" Header="Shift + колёсико: громкость SoundCloud"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="obs" Header="Следить за OBS"
                              IsCheckable="True" Click="FeatureToggle_Click"/>
                    <MenuItem Tag="obspass" Header="OBS: пароль…" Click="ObsPassword_Click"/>
                    <Separator/>
                    <MenuItem Tag="devices" Header="Показывать подключение устройств"
                              IsCheckable="True" IsChecked="True" Click="Devices_Click"/>
                    <MenuItem Tag="autostart" Header="Запускать вместе с Windows"
                              IsCheckable="True" Click="AutoStart_Click"/>
                    <Separator/>
                    <MenuItem Tag="version" Header="DreamIsland" IsEnabled="False"/>
                    <MenuItem Tag="updcheck" Header="Проверить обновления" Click="UpdateCheck_Click"/>
                    <MenuItem Tag="autoupdate" Header="Автоматически проверять обновления"
                              IsCheckable="True" IsChecked="True" Click="FeatureToggle_Click"/>
                    <Separator/>
                    <MenuItem Tag="exit" Header="Выход" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Дата (когда музыки нет) -->
                <StackPanel x:Name="IdleRow" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="DateText" Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               VerticalAlignment="Center"/>

                    <!-- Индикаторы рядом с датой: раскладка, микрофон, VPN -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="IdlePrivMic" Text="&#x25CF;" Foreground="#64D2FF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="IdlePrivCam" Text="&#x25C6;" Foreground="#BF5AF2" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="IdleObsText" Foreground="#FF453A" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="IdleLayoutText" Text="--" MinWidth="16"
                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="IdleMicIcon" Text="&#xE720;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="IdleVpnIcon" Text="&#xE785;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#8E8E93" Opacity="0.6" VerticalAlignment="Center"/>
                        <Grid x:Name="IdleVolMini" Width="22" Height="12" Margin="10,0,0,0"
                              VerticalAlignment="Center" Opacity="0.65" IsHitTestVisible="False">
                            <Border Height="3" VerticalAlignment="Top" CornerRadius="1.5" Background="#3A3A3C"/>
                            <Border x:Name="IdleVolSysFill" Height="3" Width="0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" CornerRadius="1.5" Background="White"/>
                            <Border x:Name="IdleVolBrTrack" Height="3" VerticalAlignment="Bottom"
                                    CornerRadius="1.5" Background="#3A3A3C"/>
                            <Border x:Name="IdleVolBrFill" Height="3" Width="0" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left" CornerRadius="1.5" Background="White"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Верхний ряд: обложка, название, эквалайзер -->
                <Grid x:Name="Root" Margin="12,0" Opacity="0" Visibility="Collapsed"
                      VerticalAlignment="Top" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Обложка + кольцо прогресса вокруг неё (кольцо видно в свёрнутом виде) -->
                    <Grid Grid.Column="0" MinWidth="28" MinHeight="28"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid x:Name="Ring" Width="28" Height="28" Opacity="0" Visibility="Collapsed"
                              IsHitTestVisible="False">
                            <Path x:Name="RingTrack" Stroke="White" Opacity="0.2" StrokeThickness="2"/>
                            <Path x:Name="RingFill" StrokeThickness="2" Visibility="Collapsed"
                                  StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <Border x:Name="Art"
                                Width="22" Height="22" CornerRadius="6"
                                Background="#222"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MouseLeftButtonUp="Art_Click"/>
                    </Grid>

                    <!-- Название и исполнитель (раскрытый вид) -->
                    <StackPanel x:Name="TextPanel" Grid.Column="1"
                                VerticalAlignment="Center" Margin="12,0"
                                Opacity="0" Visibility="Collapsed">
                        <TextBlock x:Name="TitleText" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Foreground="#A0A0A0"
                                   FontSize="12"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Название по центру (бегущая строка в компактном виде) -->
                    <Canvas x:Name="MarqueeHost" Grid.Column="1"
                            Height="20" Margin="10,0" VerticalAlignment="Center"
                            ClipToBounds="True" Opacity="0" Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.07"/>
                                <GradientStop Color="Black" Offset="0.93"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <TextBlock x:Name="MarqueeText" Canvas.Top="0"
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="MarqueeShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>

                    <!-- Индикаторы: раскладка, микрофон, VPN -->
                    <StackPanel x:Name="Status" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
                        <TextBlock x:Name="PrivMic" Text="&#x25CF;" Foreground="#64D2FF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PrivCam" Text="&#x25C6;" Foreground="#BF5AF2" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="ObsText" Foreground="#FF453A" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TimerText" Foreground="White" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="LayoutText" Text="--" MinWidth="16"
                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="MicIcon" Text="&#xE720;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="VpnIcon" Text="&#xE785;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#8E8E93" Opacity="0.6" VerticalAlignment="Center"/>
                        <Grid x:Name="VolMini" Width="22" Height="12" Margin="10,0,0,0"
                              VerticalAlignment="Center" Opacity="0.65" IsHitTestVisible="False">
                            <Border Height="3" VerticalAlignment="Top" CornerRadius="1.5" Background="#3A3A3C"/>
                            <Border x:Name="VolSysFill" Height="3" Width="0" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" CornerRadius="1.5" Background="White"/>
                            <Border x:Name="VolBrTrack" Height="3" VerticalAlignment="Bottom"
                                    CornerRadius="1.5" Background="#3A3A3C"/>
                            <Border x:Name="VolBrFill" Height="3" Width="0" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left" CornerRadius="1.5" Background="White"/>
                        </Grid>
                    </StackPanel>

                    <!-- Эквалайзер (цвет берётся из обложки) -->
                    <StackPanel x:Name="Bars" Grid.Column="3"
                                Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                        <Rectangle Width="3" Height="16" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1" ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="16" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2" ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="16" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3" ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- Нижняя часть раскрытого вида: прогресс и кнопки -->
                <Grid x:Name="Controls" VerticalAlignment="Bottom" Margin="18,0,18,14" Height="54"
                      Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TimeLeft" Grid.Column="0" Text="0:00"
                                   Foreground="#8E8E93" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <Grid x:Name="ProgressHost" Grid.Column="1" Height="18"
                              Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Progress_Down">
                            <Border Height="4" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center"/>
                            <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="White"
                                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TimeRight" Grid.Column="2" Text="--:--"
                                   Foreground="#8E8E93" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="56" Height="36" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="Btn_Down" MouseLeave="Btn_Reset"
                                MouseLeftButtonUp="Prev_Click">
                            <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="56" Height="36" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="Btn_Down" MouseLeave="Btn_Reset"
                                MouseLeftButtonUp="PlayPause_Click">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE769;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="56" Height="36" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="Btn_Down" MouseLeave="Btn_Reset"
                                MouseLeftButtonUp="Next_Click">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Остров TeamSpeak 3 -->
                <Grid x:Name="TsPanel" Margin="14,0" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TsIcon" Text="&#xE7F6;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TsServer" Foreground="#8E8E93" FontSize="11" MaxWidth="90"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TsTalk" Foreground="White" FontSize="13" FontWeight="SemiBold" MaxWidth="170"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel x:Name="TsWave" Orientation="Horizontal" Height="14" Margin="0,0,10,0"
                                        Visibility="Collapsed">
                                <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="TsS1" ScaleY="0.3"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="TsS2" ScaleY="0.3"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="#30D158"
                                           VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform><ScaleTransform x:Name="TsS3" ScaleY="0.3"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>

                            <!-- микрофон TeamSpeak -->
                            <TextBlock x:Name="TsMicIcon" Text="&#xE720;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- звук TeamSpeak выключен -->
                            <TextBlock x:Name="TsSpkIcon" Text="&#xE74F;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="Collapsed"/>
                            <!-- микрофон Windows — показывается только когда выключен -->
                            <StackPanel x:Name="TsWinMic" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#FF453A" VerticalAlignment="Center"/>
                                <TextBlock Text="Win" Foreground="#FF453A" FontSize="9" FontWeight="Bold"
                                           VerticalAlignment="Bottom" Margin="1,0,0,3"/>
                            </StackPanel>
                            <TextBlock x:Name="TsLayout" Text="--" MinWidth="16"
                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- при наведении: дата и время, оба микрофона, VPN, раскладка -->
                    <StackPanel x:Name="TsMore" Grid.Row="1" Margin="0,2,0,12" Opacity="0" Visibility="Collapsed">
                        <TextBlock x:Name="TsDateTime" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="TsLine1" Foreground="#A0A0A0" FontSize="12" Margin="0,6,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="TsIcons" Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TsHMic" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#30D158" VerticalAlignment="Center"/>
                                <TextBlock Text="TS" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TsHSpk" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#30D158" VerticalAlignment="Center"/>
                                <TextBlock Text="TS" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TsHWinMic" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#30D158" VerticalAlignment="Center"/>
                                <TextBlock Text="Win" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                            <TextBlock x:Name="TsHVpn" Text="&#xE785;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#8E8E93"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TsHLay" Text="--" Foreground="White" FontSize="12" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Остров «Эмоции» (видео): столбики спектра, цвет и вспышки под звук -->
                <Grid x:Name="EmoPanel" Margin="14,0" VerticalAlignment="Center" Height="40"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel x:Name="EmoBars" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Последние скопированные фрагменты (при наведении сразу после копирования) -->
                <Grid x:Name="ClipPanel" Margin="14,10,14,10" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Буфер обмена" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" Margin="10,0,0,4"/>
                        <Border x:Name="ClipRow0" Style="{StaticResource ClipRow}" Tag="0"
                                MouseLeftButtonUp="Clip_Click" Visibility="Collapsed">
                            <TextBlock x:Name="ClipText0" Foreground="White" FontSize="13"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border x:Name="ClipRow1" Style="{StaticResource ClipRow}" Tag="1"
                                MouseLeftButtonUp="Clip_Click" Visibility="Collapsed">
                            <TextBlock x:Name="ClipText1" Foreground="White" FontSize="13"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border x:Name="ClipRow2" Style="{StaticResource ClipRow}" Tag="2"
                                MouseLeftButtonUp="Clip_Click" Visibility="Collapsed">
                            <TextBlock x:Name="ClipText2" Foreground="White" FontSize="13"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border x:Name="ClipRow3" Style="{StaticResource ClipRow}" Tag="3"
                                MouseLeftButtonUp="Clip_Click" Visibility="Collapsed">
                            <TextBlock x:Name="ClipText3" Foreground="White" FontSize="13"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <Border x:Name="ClipRow4" Style="{StaticResource ClipRow}" Tag="4"
                                MouseLeftButtonUp="Clip_Click" Visibility="Collapsed">
                            <TextBlock x:Name="ClipText4" Foreground="White" FontSize="13"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Всплывающие события: громкость, микрофон, Caps Lock, раскладка -->
                <Grid x:Name="ToastPanel" Margin="18,0" Height="30" VerticalAlignment="Center"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToastThumb" Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <TextBlock x:Name="ToastIcon" Grid.Column="0" Width="26"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18" Foreground="White" VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid x:Name="VolHost" Height="6" Visibility="Collapsed">
                            <Border CornerRadius="3" Background="#3A3A3C"/>
                            <Border CornerRadius="3" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="VolScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="ToastValue" Grid.Column="2" MinWidth="44" TextAlignment="Right"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
